{
  "name": "ps5-ui-experience",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "start": "node --no-warnings server/index.js",
    "serve": "npm run build && npm start",
    "test": "node --no-warnings --test server/test/*.test.js src/uno/*.test.js src/among/core/*.test.js",
    "test:pg": "TEST_PG=1 node --no-warnings --test server/test/*.test.js",
    "e2e": "npm run build && node --no-warnings tools/e2e.mjs",
    "preview": "vite preview --host",
    "art": "node tools/render-art.mjs",
    "artifact": "node tools/artifact.mjs",
    "e2e:salon": "npm run build && node --no-warnings tools/e2e-salon.mjs",
    "e2e:mimic": "npm run build && node --no-warnings tools/e2e-mimic.mjs",
    "e2e:mimic-online": "npm run build && node --no-warnings tools/e2e-mimic-online.mjs",
    "e2e:uno": "npm run build && node --no-warnings tools/e2e-uno.mjs",
    "check:crewmate": "node tools/among/check-crewmate.mjs",
    "e2e:among": "npm run build && node --no-warnings tools/e2e-among.mjs",
    "e2e:among-online": "npm run build && node --no-warnings tools/e2e-among-online.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "^17.2.0-beta.15",
    "peer": "^1.0.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/sniglet": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/syncopate": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "peerjs": "^1.5.5",
    "pg": "^8.13.1",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
